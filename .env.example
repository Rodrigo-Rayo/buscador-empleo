# Clave de la API de Serper (https://serper.dev > API Key)
SERPER_API_KEY=tu_api_key_aqui

# --- Opcionales ---
# Páginas de 10 resultados por palabra clave (1-10). Cada página consume 1 crédito
MAX_PAGES_PER_KEYWORD=1
# Antigüedad máxima de la primera búsqueda (luego es incremental). Cada perfil puede cambiarla: d[n] días, w[n] semanas, m[n] meses
DATE_RESTRICT=w2
# Búsquedas simultáneas (1-10). Más = más rápido; si Serper limita, se reintenta sola
SEARCH_CONCURRENCY=4
